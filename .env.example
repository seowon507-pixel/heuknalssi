# 흙날씨 농지 진단 — 환경변수 템플릿
# 이 파일을 .env로 복사한 뒤 값을 채웁니다. 실제 키는 커밋하지 않습니다.
# 실행: node --env-file=/absolute/path/to/.env ui-integration/dev-server.mjs --external

# ── 서버 기본 ───────────────────────────────────────────────
NODE_ENV=development
PORT=3100
ALLOWED_ORIGINS=http://localhost:3000
# 운영에서는 32자 이상 필수. 개발 모드에서는 자동 생성됩니다.
# 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=

# 역방향 프록시 뒤에서만 설정합니다. TRUST_PROXY=true는 거부됩니다.
# TRUSTED_PROXY_RANGES=10.0.0.0/8,192.168.0.0/16

# ── dev-server 포트 ─────────────────────────────────────────
UI_PORT=3000
BACKEND_PORT=3100

# ── 외부 API 키 ─────────────────────────────────────────────
# 공공데이터포털 — 기상청 단기·중기·ASOS + 농경지화학성 V2 + 토양도 V3 공용
DATA_GO_KR_SERVICE_KEY=
# Kakao 주소 검색 REST API 키 (JavaScript 키가 아니라 REST API 키여야 합니다)
KAKAO_REST_API_KEY=
# 농장 분석 도우미. GOOGLE_AI_API_KEY > GEMINI_API_KEY > GOOGLE_API_KEY 순으로 확인
GOOGLE_AI_API_KEY=

# 스마트팜코리아 — 현재 사용하지 않습니다.
# 대상 5종 중 오이만 코호트가 있고, 코드가 참조하는 시설·노지 API는
# 발급된 키로 SERVICE_KEY_IS_NOT_REGISTERED_ERROR를 반환합니다.
# SMARTFARM_SERVICE_KEY=

# 기상청 API 허브 — 사용하지 않습니다.
# 평년값(1991-2020)은 backend-v3/runtime/climate-normal-1991-2020.json에서 읽습니다.
# KMA_API_HUB_AUTH_KEY=

# ── 어댑터 활성화 플래그 (키를 넣은 것만 true) ──────────────
ENABLE_LIVE_KAKAO=false
ENABLE_LIVE_KMA_SHORT=false
ENABLE_LIVE_KMA_MID=false
ENABLE_LIVE_KMA_ASOS=false
ENABLE_LIVE_KMA_CLIMATE_NORMAL=false
ENABLE_LIVE_SOIL=false
ENABLE_LIVE_SOIL_FIELD=false
ENABLE_SMARTFARM=false
# GOOGLE_AI_API_KEY가 있으면 자동 활성화됩니다. false로 명시하면 강제로 끕니다.
# ENABLE_GOOGLE_AI=true

# 미지원 기능 플래그 (켜도 UNSUPPORTED로만 보고됩니다)
ENABLE_SATELLITE=false
ENABLE_LLM_REPORT=false

# ── 계약 버전 (검수된 값과 일치해야 실호출이 허용됩니다) ────
KAKAO_CONTRACT_VERSION=fixture-kakao-address-v1
KMA_SHORT_CONTRACT_VERSION=fixture-kma-short-v1
KMA_MID_CONTRACT_VERSION=fixture-kma-mid-dual-v1
KMA_ASOS_CONTRACT_VERSION=data-go-asos-daily-v1-2025-09-17
KMA_CLIMATE_NORMAL_CONTRACT_VERSION=kma-climate-normal-monthly-1991-2020-local-v1
SOIL_FIELD_CONTRACT_VERSION=data-go-15144225-v1.0.0-2025-11-04

# ── 기기 이관 백업 (Supabase) ───────────────────────────────
# 테이블은 RLS로 잠겨 있고 SECURITY DEFINER 함수로만 접근합니다.
# 아래 키는 publishable(공개) 키이며 RPC 2개 호출 외에는 아무것도 못 합니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── 검증 스크립트용 ─────────────────────────────────────────
BACKEND_BASE_URL=http://127.0.0.1:3100
FRONTEND_ORIGIN=http://localhost:3000
# VERIFICATION_ADDRESS=
