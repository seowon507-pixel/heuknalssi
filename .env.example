# 흙날씨 농지 진단 — 환경변수 템플릿
# 이 파일을 .env로 복사한 뒤 값을 채웁니다. 실제 키는 커밋하지 않습니다.
# 실행: node --env-file=/absolute/path/to/.env ui-integration/dev-server.mjs --external

# ── 서버 기본 ───────────────────────────────────────────────
NODE_ENV=development
PORT=3100
ALLOWED_ORIGINS=http://localhost:3000
# 운영에서는 32자 이상 필수. 개발 모드에서는 자동 생성됩니다.
# 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=

# 역방향 프록시 뒤에서만 설정합니다. TRUST_PROXY=true는 거부됩니다.
# TRUSTED_PROXY_RANGES=10.0.0.0/8,192.168.0.0/16

# ── dev-server 포트 ─────────────────────────────────────────
UI_PORT=3000
BACKEND_PORT=3100

# ── 외부 API 키 ─────────────────────────────────────────────
# 공공데이터포털 — 기상청 단기·중기·ASOS + 농경지화학성·토양검정·토양도 공용
DATA_GO_KR_SERVICE_KEY=
# 기상청 API 허브 — 과거 단기예보 격자·관측지점 카탈로그
KMA_API_HUB_AUTH_KEY=
# APIHub는 인증키 하나를 사용하지만 세부 서비스별 활용신청이 별도입니다.
# 과거 5일 백테스트: 중기예보자료 > 1.3 중기 육상예보, 1.4 중기 기온예보
# Kakao 주소 검색 REST API 키 (JavaScript 키가 아니라 REST API 키여야 합니다)
KAKAO_REST_API_KEY=
# 농식품 팜맵 오픈API에서 발급한 인증키. 등록 도메인과 함께 서버에서만 사용합니다.
FARMMAP_API_KEY=
ENABLE_LIVE_FARMMAP=true
FARMMAP_DOMAIN=http://localhost:3000
# 농장 분석 도우미. GOOGLE_AI_API_KEY > GEMINI_API_KEY > GOOGLE_API_KEY 순으로 확인
GOOGLE_AI_API_KEY=
# Copernicus Data Space — 필지 Sentinel-2 식생지수(선택). 공개 촬영 목록만
# 확인할 때는 ID/Secret 없이 ENABLE_SATELLITE=true만 사용할 수 있습니다.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# SmartFarm은 현재 제품 범위에서 제외되어 키를 받거나 입력하지 않습니다.

# ── 어댑터 활성화 플래그 (키를 넣은 것만 true) ──────────────
ENABLE_LIVE_KAKAO=false
ENABLE_LIVE_KMA_SHORT=false
ENABLE_LIVE_KMA_MID=false
ENABLE_LIVE_KMA_ASOS=false
ENABLE_LIVE_KMA_CLIMATE_NORMAL=false
ENABLE_LIVE_KMA_LOCATION_CATALOG=false
ENABLE_LIVE_SOIL=false
ENABLE_LIVE_SOIL_FIELD=false
ENABLE_LIVE_SOIL_EXAM=false
ENABLE_FARMMAP=false
ENABLE_SMARTFARM=false
# GOOGLE_AI_API_KEY가 있으면 자동 활성화됩니다. false로 명시하면 강제로 끕니다.
# ENABLE_GOOGLE_AI=true

# 흙톡 재배 참고 지식(RAG) 검수 게이트.
# backend-v3/runtime/reviewed-knowledge-base.js의 문단은 현재 전부 reviewState:
# "DRAFT"입니다. 운영(NODE_ENV=production)에서는 DRAFT 문단이 노출되지 않으므로
# 흙톡은 기존처럼 분석 근거만으로 답합니다.
# 개발·시연에서 재배 참고와 이미지 카드를 보려면 아래를 켜세요. 화면에는
# "검수 대기 자료" 배지가 함께 표시됩니다.
# 문단을 실제 검수한 뒤에는 reviewState를 "REVIEWED"로 바꾸고 reviewedBy에
# 검수자를 적으면 이 플래그 없이도 노출됩니다.
ALLOW_DRAFT_KNOWLEDGE=false

ENABLE_SATELLITE=false
ENABLE_LLM_REPORT=false

# ── 계약 버전 (검수된 값과 일치해야 실호출이 허용됩니다) ────
KAKAO_CONTRACT_VERSION=fixture-kakao-address-v1
KMA_SHORT_CONTRACT_VERSION=fixture-kma-short-v1
KMA_MID_CONTRACT_VERSION=fixture-kma-mid-dual-v1
KMA_ASOS_CONTRACT_VERSION=data-go-asos-daily-v1-2025-09-17
KMA_CLIMATE_NORMAL_CONTRACT_VERSION=kma-climate-normal-monthly-1991-2020-local-v1
KMA_LOCATION_CATALOG_CONTRACT_VERSION=kma-api-hub-location-catalog-v1-2026-07-27
SOIL_FIELD_CONTRACT_VERSION=data-go-15144225-v1.0.0-2025-11-04
SOIL_EXAM_CONTRACT_VERSION=data-go-15144647-v1.0.0-2025-11-04
COPERNICUS_CONTRACT_VERSION=copernicus-sentinel-2-l2a-v1
FARMMAP_CONTRACT_VERSION=epis-farmmap-wfs-v1-2026-08-04

# ── 기기 이관 백업 (Supabase) ───────────────────────────────
# 선택 기능입니다. DB 테이블·RLS·함수는 별도로 배포하고 검증해야 합니다.
# 아래 비밀 키는 브라우저에 노출하면 안 되며 백엔드에서만 사용합니다.
SUPABASE_URL=
# 새 Supabase 프로젝트는 secret key 사용을 권장합니다.
SUPABASE_SECRET_KEY=
# 기존 프로젝트 호환용입니다. service_role도 서버 전용 비밀입니다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 검증 스크립트용 ─────────────────────────────────────────
BACKEND_BASE_URL=http://127.0.0.1:3100
FRONTEND_ORIGIN=http://localhost:3000
# VERIFICATION_ADDRESS=
