NODE_ENV=development
PORT=3100
SESSION_SECRET=
ALLOWED_ORIGINS=http://localhost:3000

# 기본값은 직접 연결 모드입니다. 역방향 프록시 뒤에서 운영할 때만
# 실제 프록시의 IP/CIDR을 쉼표로 구분해 명시합니다.
TRUSTED_PROXY_RANGES=

# 검수된 규칙·위치 매핑·기후/ASOS 어댑터를 조립하는 운영자 소유
# 로컬 모듈의 절대경로입니다. 미설정 시 서버는 안전하게 HOLD입니다.
TRUSTED_BACKEND_RUNTIME_MODULE=

# 계약 동결과 키 설정 전에는 라이브 어댑터가 활성화되지 않습니다.
ENABLE_LIVE_KAKAO=false
KAKAO_REST_API_KEY=
KAKAO_CONTRACT_VERSION=fixture-kakao-address-v1
ENABLE_LIVE_KMA_SHORT=false
ENABLE_LIVE_KMA_MID=false
DATA_GO_KR_SERVICE_KEY=
KMA_SHORT_CONTRACT_VERSION=fixture-kma-short-v1
KMA_MID_CONTRACT_VERSION=fixture-kma-mid-dual-v1

# 토양 V2 계약이 동결되기 전에는 false를 유지합니다.
ENABLE_LIVE_SOIL=false
SOIL_STAT_ENDPOINT=

# P1/P2는 P0 결과와 분리되며 기본 비활성입니다.
ENABLE_SMARTFARM=false
ENABLE_SATELLITE=false
ENABLE_LLM_REPORT=false
